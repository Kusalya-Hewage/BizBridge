<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3F7FA">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Services"
            android:textColor="#203449"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Make your expertise easy to book"
            android:textColor="#7D8B99"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etSearchServices"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/service_search_bg"
            android:hint="Search your services"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="#203449"
            android:textColorHighlight="#82909D"
            android:textSize="15sp" />

         <TextView
             android:id="@+id/tvServiceCount"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:layout_marginTop="22dp"
             android:layout_marginBottom="20dp"
             android:text="3 services · 2 available"
             android:textColor="#7D8B99"
             android:textSize="14sp" />

          <include
              layout="@layout/item_business_service_haircut" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/service_card_bg"
                android:orientation="vertical"
                android:padding="16dp">
           <TextView
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:text="Hair wash &amp; blow dry"
               android:textColor="#203449"
               android:textSize="17sp"
               android:textStyle="bold" />
           <TextView
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_marginTop="6dp"
               android:text="45 min Professional styling"
               android:textColor="#7D8B99"
               android:textSize="14sp" />
           <TextView
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_marginTop="5dp"
               android:text="Rs.2,500"
               android:textColor="#1976C9"
               android:textSize="16sp"
               android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/service_status_bg"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:text="AVAILABLE"
                android:textColor="#26816F"
                android:textSize="11sp"
                android:textStyle="bold" />
                <Button
                    android:id="@+id/btnEditHairWash"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="12dp"
                    android:backgroundTint="#E6F2FB"
                    android:minWidth="0dp"
                    android:text="Edit"
                    android:textAllCaps="false"
                    android:textColor="#1976C9" />
                <Button
                    android:id="@+id/btnDeleteHairWash"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#FCEBED"
                    android:minWidth="0dp"
                    android:text="Delete"
                    android:textAllCaps="false"
                    android:textColor="#C05262" />
              </LinearLayout>

            </LinearLayout>

            <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/service_card_bg"
            android:orientation="vertical"
            android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hair treatment"
                    android:textColor="#203449"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="60 min · Professional styling"
                    android:textColor="#7D8B99"
                    android:textSize="14sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Rs. 3,500"
                    android:textColor="#1976C9"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/service_status_bg"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="7dp"
                        android:text="PAUSED"
                        android:textColor="#26816F"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <Button
                        android:id="@+id/btnEditHairTreatment"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="12dp"
                        android:backgroundTint="#E6F2FB"
                        android:minWidth="0dp"
                        android:text="Edit"
                        android:textAllCaps="false"
                        android:textColor="#1976C9" />
                    <Button
                        android:id="@+id/btnDeleteHairTreatment"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="#FCEBED"
                        android:minWidth="0dp"
                        android:text="Delete"
                        android:textAllCaps="false"
                        android:textColor="#C05262" />
                </LinearLayout>
            </LinearLayout>
            <Button
                android:id="@+id/btnAddService"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#1976C9"
                android:text="+ Add Service"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="79dp"
            android:background="#FFFFFF"
            android:elevation="8dp"
            android:gravity="center"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/navDashboard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="▦\nDashboard"
                android:textColor="#7D8B99"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/navBookings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="▦\nBookings"
                android:textColor="#7D8B99"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/navServices"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="✂\nServices"
                android:textColor="#1976C9"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/navPromotions"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="◇\nPromotions"
                android:textColor="#7D8B99"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/navProfile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="♙\nProfile"
                android:textColor="#7D8B99"
                android:textSize="11sp" />

        </LinearLayout>
</LinearLayout>