<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/service_card_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Haircut"
        android:textColor="#203449"
        android:textSize="17sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="30 min · Professional styling"
        android:textColor="#7D8B99"
        android:textSize="14sp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Rs. 1,500"
        android:textColor="#1976C9"
        android:textSize="16sp"
        android:textStyle="bold" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/service_status_bg"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp"
            android:text="AVAILABLE"
            android:textColor="#26816F"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnEditHaircut"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:backgroundTint="#E6F2FB"
            android:minWidth="0dp"
            android:text="Edit"
            android:textAllCaps="false"
            android:textColor="#1976C9" />
        <Button
            android:id="@+id/btnDeleteHaircut"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#FCEBED"
            android:minWidth="0dp"
            android:text="Delete"
            android:textAllCaps="false"
            android:textColor="#C05262" />
    </LinearLayout>

</LinearLayout>