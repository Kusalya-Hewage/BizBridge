<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Back Button -->
        <TextView
            android:id="@+id/tvBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="←  Back"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true" />

        <!-- BizBridge Logo -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:src="@drawable/bizbridge_logo"
            android:contentDescription="BizBridge Logo"
            android:scaleType="fitCenter" />

        <!-- Page Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Create your account"
            android:textColor="@color/text_primary"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Join your local community"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <!-- Account Type -->
        <RadioGroup
            android:id="@+id/rgAccountType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbCustomer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="Customer"
                android:textColor="@color/primary" />

            <RadioButton
                android:id="@+id/rbBusinessOwner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Business Owner"
                android:textColor="@color/primary" />

        </RadioGroup>

        <!-- Profile Image Preview -->
        <ImageView
            android:id="@+id/ivProfileImage"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_secondary"
            android:padding="20dp"
            android:src="@android:drawable/ic_menu_camera"
            android:scaleType="centerCrop"
            android:contentDescription="Choose profile image"
            android:clickable="true"
            android:focusable="true" />

        <!-- Upload Image Text -->
        <TextView
            android:id="@+id/tvUploadImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Upload profile image\nJPG or PNG · Up to 5 MB"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Full Name -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Full name"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etFullName"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="14dp"
            android:hint="Enter your full name"
            android:inputType="textPersonName"
            android:singleLine="true" />

        <!-- Email -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Email"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etRegisterEmail"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="14dp"
            android:hint="Enter your email"
            android:inputType="textEmailAddress"
            android:singleLine="true" />

        <!-- Phone -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Phone"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="14dp"
            android:hint="Enter your phone number"
            android:inputType="phone"
            android:singleLine="true" />

        <!-- Password -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Password"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etRegisterPassword"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="14dp"
            android:hint="Create a password"
            android:inputType="textPassword"
            android:singleLine="true" />

        <!-- Confirm Password -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Confirm password"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="14dp"
            android:hint="Confirm your password"
            android:inputType="textPassword"
            android:singleLine="true" />

        <!-- Terms and Conditions -->
        <CheckBox
            android:id="@+id/cbTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="I agree to the Terms of Service and Privacy Policy"
            android:textColor="@color/text_secondary" />

        <!-- Register Button -->
        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button_primary"
            android:backgroundTint="@null"
            android:text="Create Account"
            android:textColor="@android:color/white"
            android:textAllCaps="false"
            android:textStyle="bold" />

        <!-- Login Link -->
        <TextView
            android:id="@+id/tvGoToLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="Already have an account? Login"
            android:textColor="@color/primary"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</ScrollView>
