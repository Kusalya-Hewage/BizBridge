<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F8FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Register your business"
            android:textColor="#172B4D"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="22dp"
            android:text="Join BizBridge and connect with your customers."
            android:textColor="#718096"
            android:textSize="14sp" />

        <!-- Account type -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Account type"
            android:textColor="#24364B"
            android:textStyle="bold"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/rgAccountType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbCustomer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Customer"
                android:textColor="#34465A" />

            <RadioButton
                android:id="@+id/rbBusinessOwner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:layout_marginStart="20dp"
                android:text="Business Owner"
                android:textColor="#1976C9" />
        </RadioGroup>

        <!-- Owner name -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Owner name"
            android:textColor="#24364B"
            android:textStyle="bold"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etOwnerName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:hint="Enter owner name"
            android:inputType="textCapWords"
            android:padding="12dp"
            android:background="@android:drawable/edit_text" />

        <!-- Business name -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Business name"
            android:textColor="#24364B"
            android:textStyle="bold"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etBusinessName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:hint="e.g. ABC Salon"
            android:inputType="textCapWords"
            android:padding="12dp"
            android:background="@android:drawable/edit_text" />

        <!-- Category -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Category"
            android:textColor="#24364B"
            android:textStyle="bold"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/spBusinessCategory"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:padding="8dp"
            android:background="@android:drawable/edit_text" />

        <!-- Email -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email"
            android:textColor="#24364B"
            android:textStyle="bold"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etBusinessEmail"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:hint="name@example.com"
            android:inputType="textEmailAddress"
            android:padding="12dp"
            android:background="@android:drawable/edit_text" />

        <!-- Phone -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phone"
            android:textColor="#24364B"
            android:textStyle="bold"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etBusinessPhone"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:hint="077 456 7890"
            android:inputType="phone"
            android:maxLength="15"
            android:padding="12dp"
            android:background="@android:drawable/edit_text" />

        <!-- Address -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Address"
            android:textColor="#24364B"
            android:textStyle="bold"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etBusinessAddress"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:gravity="top"
            android:hint="Enter business address"
            android:inputType="textPostalAddress|textMultiLine"
            android:padding="12dp"
            android:background="@android:drawable/edit_text" />

        <!-- Business image placeholder -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Business image"
            android:textColor="#24364B"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvUploadBusinessImage"
            android:layout_width="match_parent"
            android:layout_height="105dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:background="#E7F0FA"
            android:gravity="center"
            android:text="＋\nUpload business image\nJPG or PNG · Up to 5 MB"
            android:textColor="#1976C9"
            android:textSize="14sp" />

        <!-- Password -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Password"
            android:textColor="#24364B"
            android:textStyle="bold"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etBusinessPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:hint="Create password"
            android:inputType="textPassword"
            android:padding="12dp"
            android:background="@android:drawable/edit_text" />

        <!-- Confirm password -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Confirm password"
            android:textColor="#24364B"
            android:textStyle="bold"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etConfirmBusinessPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:hint="Re-enter password"
            android:inputType="textPassword"
            android:padding="12dp"
            android:background="@android:drawable/edit_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:text="Business accounts require administrator approval before publishing."
            android:textColor="#718096"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnRegisterBusiness"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#1976C9"
            android:text="Register Business"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
