<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3F8FC">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Promotions"
                android:textColor="#172B4D"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Give your community a reason to return"
                android:textColor="#7B8B99"
                android:textSize="14sp" />

            <!-- Active / Expired tabs -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_promotion_tabs"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/tabActivePromotions"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_promotion_tab_selected"
                    android:gravity="center"
                    android:text="Active"
                    android:textColor="#1976C9"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabExpiredPromotions"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Expired"
                    android:textColor="#718194"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvPromotionSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="20dp"
                android:text="1 active promotion · 36 views this week"
                android:textColor="#7B8B99"
                android:textSize="14sp" />

            <!-- Promotion card -->

            <LinearLayout
                android:id="@+id/promotionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_promotion_card"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:background="@drawable/bg_promotion_icon"
                        android:gravity="center"
                        android:text="%"
                        android:textColor="#FFFFFF"
                        android:textSize="34sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPromotionTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="20% OFF Haircut"
                            android:textColor="#172B4D"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPromotionBusiness"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="ABC Salon · Valid until 20 Oct"
                            android:textColor="#367EB6"
                            android:textSize="14sp" />

                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPromotionDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="A fresh look for less. Book your next haircut and save."
                    android:textColor="#748697"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPromotionStatus"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="ACTIVE"
                        android:textColor="#27836F"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnEditPromotion"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:backgroundTint="#E7F3FC"
                        android:text="Edit"
                        android:textAllCaps="false"
                        android:textColor="#1976C9"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnDeletePromotion"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:backgroundTint="#FCEAEC"
                        android:text="Delete"
                        android:textAllCaps="false"
                        android:textColor="#C45A68"
                        android:textSize="14sp" />

                </LinearLayout>
            </LinearLayout>

            <!-- Offer schedule -->

            <TextView
                android:id="@+id/tvPromotionSchedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Offer runs from 9–20 October 2026. Available for Haircut appointments only."
                android:textColor="#7B8B99"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />

            <!-- Performance heading -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Offer performance"
                android:textColor="#172B4D"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Performance cards -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_promotion_stat"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvOfferViews"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="36"
                        android:textColor="#1976C9"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Offer views"
                        android:textColor="#7B8B99"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_promotion_stat"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvOfferSaved"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="08"
                        android:textColor="#1976C9"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Saved by customers"
                        android:textColor="#7B8B99"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Tips card -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_promotion_stat"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Make your next offer stand out"
                    android:textColor="#172B4D"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Use a clear photo, a simple discount and a short description. Your offer appears in nearby customers' feeds."
                    android:textColor="#7B8B99"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>

            <!-- Create promotion -->

            <Button
                android:id="@+id/btnCreatePromotion"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="20dp"
                android:backgroundTint="#1976C9"
                android:text="+ Create Promotion"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom navigation -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/navDashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▦\nDashboard"
            android:textColor="#82919E"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/navBookings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▣\nBookings"
            android:textColor="#82919E"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/navServices"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⚒\nServices"
            android:textColor="#82919E"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/navPromotions"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="◇\nPromotions"
            android:textColor="#1976C9"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♙\nProfile"
            android:textColor="#82919E"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>
