<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/btnDetailsBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹"
            android:textSize="34sp"
            android:textColor="@color/text_primary"
            android:padding="6dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Booking details"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"/>

        <TextView
            android:id="@+id/tvDetailsBookingId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Booking ID"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_dashboard_card">

            <TextView
                android:id="@+id/tvDetailsBusiness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Business name"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

            <TextView
                android:id="@+id/tvDetailsService"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Service"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"/>

            <TextView
                android:id="@+id/tvDetailsStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_dashboard_category"
                android:padding="8dp"
                android:text="PENDING"
                android:textStyle="bold"
                android:textColor="@color/secondary"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="@color/input_border"/>

            <TextView
                android:id="@+id/tvDetailsDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="Date"
                android:textColor="@color/text_primary"/>

            <TextView
                android:id="@+id/tvDetailsTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="Time"
                android:textColor="@color/text_primary"/>

            <TextView
                android:id="@+id/tvDetailsDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="Duration"
                android:textColor="@color/text_primary"/>

            <TextView
                android:id="@+id/tvDetailsPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="Price"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

            <TextView
                android:id="@+id/tvDetailsAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="Address"
                android:textColor="@color/text_primary"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@color/light_blue"
            android:padding="16dp"
            android:text="Your appointment status is shown above. A PENDING booking has not yet been confirmed by the business."
            android:textColor="@color/primary_dark"
            android:textSize="14sp"/>

        <Button
            android:id="@+id/btnShowAppointmentQr"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_button_primary"
            android:text="Show Appointment QR"
            android:textAllCaps="false"
            android:textColor="@color/white"/>

        <Button
            android:id="@+id/btnCancelDetailsBooking"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:text="Cancel Booking"
            android:textAllCaps="false"
            android:textColor="@color/error"/>

        <Button
            android:id="@+id/btnCallBusiness"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_secondary"
            android:text="Call Business"
            android:textAllCaps="false"
            android:textColor="@color/primary"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingBottom="20dp"
            android:text="Please contact the business if you need to change your appointment."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"/>

    </LinearLayout>
</ScrollView>
